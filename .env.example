# Application
NODE_ENV=development
PORT=3000
APP_NAME=social-media-api

# Application URLs
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Database (PostgreSQL Connection String)
DATABASE_URL=postgresql://user:password@localhost:5432/medsos_db?schema=public

# JWT Tokens Secrets & Expiries
JWT_SECRET=your_super_secret_access_jwt_key_here
JWT_SECRET_REFRESH=your_super_secret_refresh_jwt_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REGISTER_EXPIRES=1d

# Email Transporter (SMTP)
EMAIL_HOST=smtp.brevo.com
EMAIL_HOST_PORT=587
EMAIL_LOGIN=your_smtp_login
EMAIL_PASSWORD=your_smtp_password
FROM_EMAIL=no-reply@yourdomain.com

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
AUTH_LIMIT_WINDOW_MINS=15
AUTH_LIMIT_MAX_ATTEMPTS=10
EMAIL_LIMIT_WINDOW_MINS=5
EMAIL_LIMIT_MAX_ATTEMPTS=3
GLOBAL_LIMIT_WINDOW_MINS=1
GLOBAL_LIMIT_MAX_ATTEMPTS=100

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAMES=your_cloudinary_cloud_name
CLOUDINARY_API_KEYS=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Encryption Keys (Must be 64-character hex string = 32 bytes for AES-256)
MESSAGE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
